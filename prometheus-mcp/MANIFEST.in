# Ship the web UI asset in sdists (wheels from the flat layout won't carry
# data files — the Docker image copies ui/ explicitly and webui.py has a
# /app/ui fallback, so this only matters for source installs).
include ui/index.html
include saved_queries.py
# Auth module (fleet mcp_auth adoption): py-modules already covers wheels,
# but an sdist built without this file would silently omit it — the exact
# silent-omission class the packaging tests pin.
include mcp_auth.py
